      "boundElements": [],
      "updated": 1746066228894,
      "link": null,
      "locked": false,
      "text": "OBRIGATORIO:\n    fazer login/cadastro\n    \n    add entrada/quanto de dinheiro entrou naquele mês\n    add saida/(gastos)quanto de dinheiro saiu naquele mês\n    editar a transação(ex: mudar,titulo,categoria,\n    apagar transação\n    vizualizar lucro/recereita daquele mês\n    listar gastos(outputs)\n    listar entradas(inputs)\n    listar todos\n    ver se algum gasto é recorrente(ex: academia, faculdade, plano de algo)\n    \nDESEJAVEIS:\n    compras parceladas\n    relatorio com gastos do mes",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "AhhWwcPERzN60u9OpVKl7",
      "originalText": "OBRIGATORIO:\n    fazer login/cadastro\n    \n    add entrada/quanto de dinheiro entrou naquele mês\n    add saida/(gastos)quanto de dinheiro saiu naquele mês\n    editar a transação(ex: mudar,titulo,categoria,\n    apagar transação\n    vizualizar lucro/recereita daquele mês\n    listar gastos(outputs)\n    listar entradas(inputs)\n    listar todos\n    ver se algum gasto é recorrente(ex: academia, faculdade, plano de algo)\n    \nDESEJAVEIS:\n    compras parceladas\n    relatorio com gastos do mes",
      "autoResize": true,
      "lineHeight": 1.25
    },
